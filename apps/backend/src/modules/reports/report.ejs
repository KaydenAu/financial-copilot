<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Financial Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 30px;
        }

        h1 {
            margin-bottom: 20px;
        }

        .section {
            margin-bottom: 25px;
        }

        ul {
            padding-left: 20px;
        }
    </style>
</head>

<body>
    <h1>Financial Report</h1>
    <div class="section">
        <h2>Summary</h2>
        <p>
            <%= report.summary %>
        </p>
    </div>

    <div class="section">
        <h2>Insights</h2>
        <ul>
            <% report.insights.forEach(item=> { %>
                <li>
                    <%= item %>
                </li>
                <% }) %>
        </ul>
    </div>

    <div class="section">
        <h2>Highlights</h2>
        <ul>
            <% report.highlights.forEach(item=> { %>
                <li>
                    <%= item %>
                </li>
                <% }) %>
        </ul>
    </div>

    <div class="section">
        <h2>Total Spending</h2>
        <p>RM <%= total %>
        </p>
    </div>
</body>

</html>