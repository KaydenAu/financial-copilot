enum SupportCategory {
  ACCOUNT
  TRANSACTIONS
  BILLING
  SECURITY
  TECHNICAL
  FEATURE
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id Int @id @default(autoincrement())

  name String?
  email String

  category SupportCategory
  message String

  status SupportStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}