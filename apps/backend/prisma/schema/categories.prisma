model Category {
  id          Int        @id @default(autoincrement())
  name        String
  description String?    @db.Text
  parentId    Int?

  // User relationship
  userId      Int
  user        CustomUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")

  transactions            Transaction[] @relation("TransactionCategory")
  subcategoryTransactions Transaction[] @relation("TransactionSubcategory")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([userId])
  @@unique([userId, name, parentId])

  @@map("categories")
}