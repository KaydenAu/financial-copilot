model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("New Chat Session")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]
  
  userId    Int           @map("user_id")
  user      CustomUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_sessions") // Maps the model to snake_case database tables
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  role      String      // Constrained to: "user" | "assistant" | "system"
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  // Cascading block handles cleanup dynamically when parent sessions are deleted
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}