model Transaction {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             CustomUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId       Int
  subcategoryId    Int?

  transactionDate  DateTime

  account          String
  currency         String

  amount           Decimal   @db.Decimal(12, 2)

  description      String?   @db.Text

  category          Category  @relation("TransactionCategory", fields: [categoryId], references: [id])
  subcategory       Category? @relation("TransactionSubcategory", fields: [subcategoryId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([transactionDate])

  @@map("transactions")
}